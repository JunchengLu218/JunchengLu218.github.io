{% assign fontawesome = site.third_party_libraries.fontawesome %}
{% if fontawesome %}
  {% assign fontawesome_css = fontawesome.url.css | replace: '{{version}}', fontawesome.version %}
  <link
    rel="stylesheet"
    href="{{ fontawesome_css }}"
    {% if fontawesome.integrity.css %}
      integrity="{{ fontawesome.integrity.css }}" crossorigin="anonymous"
    {% endif %}
  >
{% endif %}

